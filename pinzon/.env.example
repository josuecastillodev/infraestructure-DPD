# Usuario de Postgres (lo usa el contenedor db y el healthcheck)
POSTGRES_USER=pinzon
# Contraseña de Postgres (genera una fuerte, p. ej. `openssl rand -hex 32`)
POSTGRES_PASSWORD=changeme
# Nombre de la base de datos que Postgres crea al inicializar
POSTGRES_DB=pinzon
# Cadena de conexión que usa la API (host = nombre del servicio en la red interna)
DATABASE_URL=postgresql://pinzon:changeme@db:5432/pinzon
# Origen permitido por CORS en la API (la URL pública de la app)
CORS_ORIGIN=https://app.pinzontravel.com
# Si es "true", el entrypoint de la API ejecuta el seed de Prisma al arrancar.
# Útil para poblar la demo la primera vez; dejar en false después.
SEED_ON_START=false
# Puerto interno de la API (debe coincidir con el label de Traefik: 3000)
PORT=3000
