# API token de Cloudflare para el dnsChallenge (resolver letsencrypt-dns).
# Crear en https://dash.cloudflare.com/profile/api-tokens con permisos
# Zone:DNS:Edit y Zone:Zone:Read sobre las zonas de las plataformas.
CF_DNS_API_TOKEN=changeme

# Token de DuckDNS (https://www.duckdns.org) para el resolver letsencrypt-duckdns
# (demo de dromo sin dominio propio).
DUCKDNS_TOKEN=changeme
