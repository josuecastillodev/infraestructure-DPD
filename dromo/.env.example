# Dominio de dromo. PLACEHOLDER: reemplazar por el dominio real cuando se compre.
# Todos los labels de Traefik del compose interpolan esta variable (${DROMO_DOMAIN}).
# Para la demo sin dominio propio se usa un subdominio de DuckDNS
# (p. ej. dromo-dpd.duckdns.org) junto con DROMO_CERT_RESOLVER=letsencrypt-duckdns.
DROMO_DOMAIN=dromo-demo.example.com
# Resolver ACME de Traefik para los certificados. Default: letsencrypt-dns
# (Cloudflare, para el dominio real). Para la demo DuckDNS: letsencrypt-duckdns.
DROMO_CERT_RESOLVER=letsencrypt-dns
# Usuarios de basic auth para el pre-lanzamiento, en formato htpasswd (user:hash).
# Generar con: htpasswd -nB usuario
# IMPORTANTE: mantener el valor entre comillas simples para que los `$` del hash
# no se interpreten como variables. Verificar con `docker compose config`.
DROMO_BASIC_AUTH='admin:$2y$05$reemplazar-por-hash-real'

# --- Postgres (cluster: control plane + DBs de tenant) ---
# Superusuario del cluster (lo usa el contenedor db y el healthcheck)
POSTGRES_USER=postgres
# Contraseña del superusuario (genera una fuerte, p. ej. `openssl rand -hex 32`)
POSTGRES_PASSWORD=changeme
# Contraseña del usuario de aplicación route_provisioner (CREATEDB/CREATEROLE,
# lo crea postgres/init.sh en el primer arranque)
ROUTE_PROVISIONER_PASSWORD=changeme
# Contraseña del usuario pgbouncer_authenticator (solo ejecuta la función de
# auth_query; la crea postgres/init.sh en el primer arranque)
PGBOUNCER_AUTH_PASSWORD=changeme

# --- Redis (BullMQ + revocation list) ---
# Contraseña de Redis (la exige --requirepass y la usa el healthcheck)
REDIS_PASSWORD=changeme

# --- API (@route-platform/api) ---
# Entorno de ejecución de Node/Nest
NODE_ENV=production
# Puerto interno de la API (debe coincidir con el label de Traefik: 3000)
PORT=3000
# Nivel de logs de pino (trace|debug|info|warn|error)
LOG_LEVEL=info
# Conexión al control plane VÍA PGBOUNCER (transaction pooling)
CONTROL_PLANE_DATABASE_URL=postgresql://route_provisioner:changeme@pgbouncer:6432/route_control
# Conexión DIRECTA a Postgres (5432, sin PgBouncer) para `prisma migrate deploy`
# del entrypoint: las migraciones usan advisory locks que el transaction pooling
# no soporta
CONTROL_PLANE_MIGRATIONS_URL=postgresql://route_provisioner:changeme@db:5432/route_control
# Conexión a Redis para BullMQ
REDIS_URL=redis://default:changeme@redis:6379

# --- Infisical (gestor de secretos: el resto de credenciales de la API ---
# --- JWT, S3/R2, SMTP, etc. — se leen de Infisical en runtime) ---
# URL de la instancia de Infisical (cloud o self-hosted)
INFISICAL_SITE_URL=https://app.infisical.com
# Credenciales machine identity (universal auth) del proyecto en Infisical
INFISICAL_CLIENT_ID=changeme
INFISICAL_CLIENT_SECRET=changeme
# ID del proyecto de Infisical que contiene los secretos de dromo
INFISICAL_PROJECT_ID=changeme
# Entorno de Infisical del que se leen los secretos (p. ej. prod)
INFISICAL_ENVIRONMENT=prod
